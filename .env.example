# Intent Scheduler — server configuration (M2: Google Calendar booking)
#
# Copy to `.env.local` for local development, or set each variable in your host's
# environment settings (Vercel → Project → Settings → Environment Variables).
# NEVER commit real values. NEVER paste them into chat or issues.
# Only variables prefixed NEXT_PUBLIC_ are visible to the browser; none of those are secret.

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Used for redirects, booking-management links
# and the CSRF origin check. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts Google OAuth tokens at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
# Changing it makes stored Google connections unreadable → hosts must reconnect.
APP_ENCRYPTION_KEY=

# ≥32 random characters. Signs host session cookies, OAuth state cookies and
# visitor "reschedule or cancel" links. Rotating it signs everyone out and
# invalidates existing management links.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# Hold length while a visitor types their name/email (seconds, 60–1800).
BOOKING_HOLD_TTL_SECONDS=600

# ── Database (Supabase Postgres, or any Postgres ≥14 with btree_gist) ─────────
# Supabase: Project Settings → Database → Connection string → URI.
# Serverless (Vercel): use the *Transaction pooler* URI (port 6543).
# Long-running server/Docker: the direct or Session pooler URI is fine.
# Server-only. The app connects as the table owner; Supabase's REST API is
# locked out by RLS (see supabase/migrations/0002_m2_google_booking.sql).
DATABASE_URL=
# Optional but recommended: PEM of Supabase's server CA (Database settings →
# SSL Configuration → Download certificate). When set, TLS is fully verified.
# When unset, remote connections are encrypted but the certificate is not verified.
DATABASE_CA_CERT=
# Max connections per server instance (keep small on serverless).
DATABASE_POOL_MAX=5

# ── Google OAuth (Google Cloud Console) ───────────────────────────────────────
# 1. Create/choose a project → APIs & Services → Library → enable "Google Calendar API".
# 2. OAuth consent screen: External (or Internal for Workspace), add yourself as a Test user.
# 3. Credentials → Create credentials → OAuth client ID → Web application.
#    Authorized redirect URI must equal GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
# Optional, space-separated. Default (least privilege):
#   openid email profile
#   https://www.googleapis.com/auth/calendar.calendarlist.readonly
#   https://www.googleapis.com/auth/calendar.freebusy
#   https://www.googleapis.com/auth/calendar.events.owned
# If availability fails with 403 insufficientPermissions during UAT, replace
# calendar.freebusy with https://www.googleapis.com/auth/calendar.events.freebusy
# (or calendar.readonly) here and reconnect.
GOOGLE_OAUTH_SCOPES=

# ── AI (optional; never required for direct booking — see M3) ─────────────────
# mock | gateway | openai-compatible
AI_MODE=mock
AI_MODEL_DEFAULT=
AI_MODELS_ALLOWED=
AI_GATEWAY_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ── Not used in M2 (reserved for M4/M5; leave empty) ─────────────────────────
# MICROSOFT_CLIENT_ID= MICROSOFT_CLIENT_SECRET= MICROSOFT_TENANT=common
# MICROSOFT_REDIRECT_URI=http://localhost:3000/api/oauth/microsoft/callback
# ZOHO_CLIENT_ID= ZOHO_CLIENT_SECRET= ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
# ZOHO_REDIRECT_URI=http://localhost:3000/api/oauth/zoho/callback
# MCP_PUBLIC_ENABLED=false MCP_AUTH_TOKEN=
